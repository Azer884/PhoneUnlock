#include <windows.h>
#include "resource.h"

IDI_APP             ICON    "src\\app.ico"
IDR_PROVIDER_DLL    RCDATA  "bin\\PhoneUnlockCP.dll"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Phone Unlock"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "PhoneUnlock"
            VALUE "OriginalFilename", "PhoneUnlockSetup.exe"
            VALUE "ProductName", "Phone Unlock"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 320, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Phone Unlock"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Unlock this PC by unlocking your Android phone.", -1, 10, 8, 300, 10
    LTEXT           "", IDC_STATUS, 10, 22, 232, 40, SS_NOPREFIX
    PUSHBUTTON      "Install", IDC_INSTALL, 248, 22, 64, 16

    GROUPBOX        "1.  Your Windows password", -1, 7, 66, 306, 52
    LTEXT           "Your Microsoft account (or local account) password, not your PIN. Windows stores it encrypted.", -1, 14, 78, 292, 16, SS_NOPREFIX
    EDITTEXT        IDC_PASSWORD, 14, 96, 222, 14, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "Save", IDC_SAVEPWD, 242, 95, 64, 16

    GROUPBOX        "2.  Pair your phone", -1, 7, 124, 306, 62
    LTEXT           "Pair the phone with this PC in Windows Bluetooth settings first. Then click Pair here and tap ""Pair with PC"" in the phone app.", -1, 14, 136, 292, 18, SS_NOPREFIX
    PUSHBUTTON      "Pair", IDC_PAIR, 14, 160, 64, 16
    LTEXT           "", IDC_PAIRSTATUS, 84, 159, 222, 22, SS_NOPREFIX

    GROUPBOX        "3.  Test", -1, 7, 192, 306, 46
    PUSHBUTTON      "Test", IDC_TEST, 14, 208, 64, 16
    LTEXT           "Click Test, then lock and unlock your phone.", IDC_TESTSTATUS, 84, 207, 222, 24, SS_NOPREFIX

    AUTOCHECKBOX    "Unlock with my phone is on", IDC_ENABLED, 10, 246, 200, 12

    LTEXT           "", IDC_VERSION, 10, 276, 60, 10
    CONTROL         "<a>GitHub</a>", IDC_GITHUB, "SysLink", WS_TABSTOP, 70, 276, 60, 10
    PUSHBUTTON      "Uninstall", IDC_UNINSTALL, 176, 272, 64, 16
    DEFPUSHBUTTON   "Close", IDCANCEL, 248, 272, 64, 16
END
